{
  "name": "vipdesk-site",
  "private": true,
  "type": "module",
  "description": "Site institucional do VipDesk (vipdesk.com.br), gerado estaticamente para GitHub Pages.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:sync": "node scripts/build.mjs --check",
    "serve": "node scripts/serve.mjs",
    "test": "npm run check:sync && npm run test:static && npm run audit && npm run test:e2e",
    "test:static": "node --test \"tests/static/*.test.mjs\"",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit.mjs",
    "audit:prod": "SEO_BASE_URL=https://vipdesk.com.br node scripts/audit.mjs --out seo-audit-producao.md",
    "test:prod": "SEO_BASE_URL=https://vipdesk.com.br playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
